{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "github>aquaproj/aqua-renovate-config#2.13.0",
    "github>kachick/renovate-config-dprint#1.4.0"
  ],
  "minimumReleaseAge": "5 days",
  "commitMessagePrefix": "deps:",
  "packageRules": [
    {
      "matchPackageNames": [
        "aquaproj/aqua-registry"
      ],
      "extends": [
        "schedule:earlyMondays"
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "minimumReleaseAge": "5 days"
    },
    {
      "matchManagers": ["github-actions"],
      "commitMessagePrefix": "ci:"
    },
    {
      "matchDatasources": ["npm"],
      "commitMessagePrefix": "npm:"
    },
    {
      "matchFileNames": ["**/aqua.yaml", "**/aqua.yml", "**/.aqua.yaml", "**/.aqua.yml"],
      "commitMessagePrefix": "aqua:"
    },
    {
      "matchPackageNames": ["aquaproj/aqua"],
      "commitMessagePrefix": "aqua:"
    },
    {
      "matchFileNames": ["dprint.json"],
      "commitMessagePrefix": "dprint:"
    },
    {
      "matchFileNames": ["renovate.json"],
      "commitMessagePrefix": "renovate:"
    },
    {
      "groupName": "pi",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["/^@earendil-works//"]
    }
  ]
}
